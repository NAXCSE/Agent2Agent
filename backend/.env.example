# Scraping
APIFY_API_TOKEN=
LINKEDIN_ACTOR_ID=harvestapi/linkedin-profile-scraper
INSTAGRAM_ACTOR_ID=apify/instagram-profile-scraper

# LLM provider: gemini | openai | openai-compatible | anthropic
LLM_PROVIDER=gemini

# Gemini. Free-tier keys lose access to older models ("404 no longer
# available"), so GEMINI_FALLBACK_MODELS is tried automatically if the primary
# model is retired or at capacity.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
GEMINI_FALLBACK_MODELS=gemini-flash-lite-latest,gemini-3.5-flash-lite,gemini-flash-latest

# Any OpenAI-compatible endpoint (OpenAI, Groq, Together, OpenRouter,
# DeepSeek, Ollama, LM Studio, vLLM). Requires: pip install openai
OPENAI_API_KEY=
OPENAI_BASE_URL=
OPENAI_MODEL=gpt-4o-mini

# Anthropic. Requires: pip install anthropic
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-5